# The Arasan engine linked into the app (iOS can't run it as a child process).
# libarasan.a and the network are generated by native/build-arasan-ios.sh.
Pod::Spec.new do |s|
  s.name           = 'ArasanEngine'
  s.version        = '0.1.0'
  s.summary        = 'Arasan chess engine, in process, over UCI'
  s.license        = 'MIT'
  s.author         = 'Peermate'
  s.homepage       = 'https://github.com/jdart1/arasan-chess'
  s.platforms      = { :ios => '15.1' }
  s.swift_version  = '5.9'
  s.source         = { git: '' }
  s.static_framework = true

  s.dependency 'ExpoModulesCore'

  s.source_files = '*.{h,mm,swift}'
  s.public_header_files = 'ArasanBridge.h'
  s.vendored_libraries = 'libarasan.a'
  s.resources = '*.nnue'
  s.libraries = 'c++'
  s.pod_target_xcconfig = {
    'DEFINES_MODULE' => 'YES',
    'SWIFT_COMPILATION_MODE' => 'wholemodule'
  }
end
