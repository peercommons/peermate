{
  "expo": {
    "name": "Peermate",
    "slug": "peermate",
    "version": "0.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.peermate.app",
      "appleTeamId": "QGLA89KHM7",
      "entitlements": {
        "com.apple.developer.kernel.extended-virtual-addressing": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2A6447",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.peermate.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ],
            "extraProguardRules": "# WorkManager (expo-background-task) builds its Room database by reflection; R8 stripped the constructor.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }"
          }
        }
      ],
      [
        "expo-bare-kit",
        {
          "workers": [
            [
              "p2p/worker.js",
              {
                "hosts": [
                  "android-arm64",
                  "android-x64",
                  "ios-arm64",
                  "ios-arm64-simulator",
                  "ios-x64-simulator"
                ]
              }
            ]
          ]
        }
      ],
      "./plugins/without-remote-push.js",
      "expo-notifications",
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "Peermate uses the camera to scan a friend's QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "scheme": "peermate"
  }
}
