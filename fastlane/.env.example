# Copy to fastlane/.env (gitignored) and fill in. Fastlane loads it automatically.
PEERMATE_KEYSTORE_PATH=~/.peermate/peermate-release.jks
PEERMATE_KEYSTORE_PASSWORD=
PEERMATE_KEY_ALIAS=peermate
PEERMATE_KEY_PASSWORD=

# Only needed for `fastlane android sideload publish:true`
GITHUB_TOKEN=
PEERMATE_GITHUB_REPO=owner/peermate

# ---- Store uploads (Phase 4) ----
# Google Play: service-account JSON key with access to the app in Play Console
# (Users and permissions). `android beta|promote|rollout|metadata`.
PEERMATE_PLAY_JSON_KEY=~/.peermate/play-service-account.json

# App Store Connect API key (Users and Access > Integrations > App Store Connect API,
# role App Manager). Give the .p8 as a file path, or its contents in ASC_KEY_P8 (CI).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.peermate/AuthKey_XXXXXXXXXX.p8
ASC_KEY_P8=

# fastlane match: a PRIVATE, empty git repo holding the encrypted App Store
# certificate and profile, and the passphrase that encrypts them.
MATCH_GIT_URL=
MATCH_PASSWORD=

# App Review contact (seen only by Apple's reviewers; `ios metadata` / `ios release`).
# Phone in international format, e.g. +63 917 123 4567. Email defaults to support@peercommons.org.
PEERMATE_REVIEW_FIRST_NAME=
PEERMATE_REVIEW_LAST_NAME=
PEERMATE_REVIEW_PHONE=
PEERMATE_REVIEW_EMAIL=
