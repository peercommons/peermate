# Peermate release automation. See SPECS.md §13.
#
#   bundle exec fastlane android sideload              # signed APK in dist/
#   bundle exec fastlane android sideload publish:true # ...and attach it to a GitHub Release
#   bundle exec fastlane ios device                    # signed IPA in dist/, installed on the USB iPhone
#   bundle exec fastlane ios device install:false      # ...build only
#
# Secrets come from environment variables, or from fastlane/.env (gitignored;
# copy fastlane/.env.example). Create the signing key once with
# scripts/create-release-keystore.sh.

require 'json'

APP_DIR = File.expand_path('../app', __dir__)
DIST_DIR = File.expand_path('../dist', __dir__)

def require_env!(*names)
  missing = names.reject { |n| ENV[n] && !ENV[n].empty? }
  UI.user_error!("Missing environment variables: #{missing.join(', ')}") unless missing.empty?
end

def marketing_version
  JSON.parse(File.read(File.join(APP_DIR, 'app.json')))['expo']['version']
end

# Android only installs an update if its versionCode is higher than the
# installed one. The commit count on the release branch only ever grows.
def next_version_code
  Integer(sh('git rev-list --count HEAD', log: false).strip)
end

default_platform(:android)

platform :android do
  desc 'Build a signed universal release APK for sideloading (optionally publish to a GitHub Release)'
  lane :sideload do |options|
    require_env!('PEERMATE_KEYSTORE_PATH', 'PEERMATE_KEYSTORE_PASSWORD',
                 'PEERMATE_KEY_ALIAS', 'PEERMATE_KEY_PASSWORD')

    version = marketing_version
    code = options[:version_code] ? Integer(options[:version_code]) : next_version_code
    ENV['PEERMATE_VERSION_CODE'] = code.to_s # read by app/app.config.js

    # Regenerate the native project from app.json (Continuous Native Generation).
    sh("cd #{APP_DIR} && CI=1 npx expo prebuild -p android --clean --no-install")

    # The injected signing properties override the debug signing config in the
    # generated build.gradle, so the APK is signed with the release key.
    gradle(
      project_dir: File.join(APP_DIR, 'android'),
      task: 'assemble',
      build_type: 'Release',
      print_command: false, # keep passwords out of the log
      properties: {
        'android.injected.signing.store.file' => File.expand_path(ENV['PEERMATE_KEYSTORE_PATH']),
        'android.injected.signing.store.password' => ENV['PEERMATE_KEYSTORE_PASSWORD'],
        'android.injected.signing.key.alias' => ENV['PEERMATE_KEY_ALIAS'],
        'android.injected.signing.key.password' => ENV['PEERMATE_KEY_PASSWORD']
      }
    )

    FileUtils.mkdir_p(DIST_DIR)
    apk = File.join(DIST_DIR, "peermate-#{version}-#{code}.apk")
    FileUtils.cp(lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH], apk)
    UI.success("APK ready: #{apk}")

    if options[:publish]
      require_env!('GITHUB_TOKEN', 'PEERMATE_GITHUB_REPO')
      set_github_release(
        repository_name: ENV['PEERMATE_GITHUB_REPO'], # e.g. "you/peermate"
        api_token: ENV['GITHUB_TOKEN'],
        tag_name: "v#{version}-#{code}",
        name: "Peermate #{version} (#{code})",
        commitish: sh('git rev-parse HEAD', log: false).strip,
        description: "Sideload build #{code}. On Android, allow \"Install unknown apps\" for your browser or file manager, then open the APK.",
        is_prerelease: true,
        upload_assets: [apk]
      )
    end

    apk
  end
end

# iOS: development-signed builds for our own registered devices (no App Store or
# TestFlight yet). Signed with the user's team only; see SPECS.md §13.
IOS_TEAM_ID = 'QGLA89KHM7'

# The first connected physical iPhone, or PEERMATE_IOS_DEVICE (a UDID).
def ios_device
  return ENV['PEERMATE_IOS_DEVICE'] unless ENV['PEERMATE_IOS_DEVICE'].to_s.empty?

  out = File.join(Dir.tmpdir, "peermate-devices-#{Process.pid}.json")
  sh("xcrun devicectl list devices --json-output #{out} >/dev/null", log: false)
  devices = JSON.parse(File.read(out)).dig('result', 'devices') || []
  File.delete(out)
  phone = devices.find do |d|
    d.dig('hardwareProperties', 'platform') == 'iOS' &&
      d.dig('hardwareProperties', 'reality') == 'physical' &&
      d.dig('connectionProperties', 'pairingState') == 'paired' &&
      d.dig('connectionProperties', 'tunnelState') == 'connected'
  end
  UI.user_error!('No connected iPhone found (plug it in and unlock it, or set PEERMATE_IOS_DEVICE)') unless phone
  phone.dig('hardwareProperties', 'udid')
end

platform :ios do
  desc 'Build a development-signed release IPA and install it on the connected iPhone'
  lane :device do |options|
    version = marketing_version
    code = options[:version_code] ? Integer(options[:version_code]) : next_version_code
    ENV['PEERMATE_VERSION_CODE'] = code.to_s # read by app/app.config.js

    # The in-process engine (gitignored build output).
    engine = File.join(APP_DIR, 'modules/arasan-engine/ios/Arasan.xcframework')
    sh(File.expand_path('../native/build-arasan-ios.sh', __dir__)) unless File.exist?(engine)

    # Regenerate the native project from app.json (Continuous Native Generation).
    # Outside Bundler, so `pod install` uses the system CocoaPods (it isn't in our
    # Gemfile). Prebuild rewrites app/tsconfig.json; put it back.
    Bundler.with_unbundled_env do
      # (It also resets ENV, so the build number is passed explicitly.)
      sh("cd #{APP_DIR} && CI=1 PEERMATE_VERSION_CODE=#{code} npx expo prebuild -p ios --clean && git checkout tsconfig.json")
    end

    FileUtils.mkdir_p(DIST_DIR)
    name = "peermate-#{version}-#{code}.ipa"
    build_app(
      workspace: File.join(APP_DIR, 'ios/Peermate.xcworkspace'),
      scheme: 'Peermate',
      configuration: 'Release',
      export_method: 'development',
      export_team_id: IOS_TEAM_ID,
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{IOS_TEAM_ID}",
      export_xcargs: '-allowProvisioningUpdates',
      derived_data_path: File.join(APP_DIR, 'ios/build'),
      output_directory: DIST_DIR,
      output_name: name,
      skip_profile_detection: true,
      include_symbols: false
    )
    ipa = File.join(DIST_DIR, name)
    UI.success("IPA ready: #{ipa}")

    unless options[:install] == false
      udid = ios_device
      sh('xcrun', 'devicectl', 'device', 'install', 'app', '--device', udid, ipa)
      UI.success("Installed on #{udid}")
    end

    ipa
  end
end
